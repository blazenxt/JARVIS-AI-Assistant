# ====================================================
# JARVIS AI ASSISTANT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your API keys
# ====================================================

# ----------------------------------------------------
# 1. AI BRAIN BACKEND SELECTION
# Options: groq | gemini | openai | ollama | offline
# ----------------------------------------------------
AI_BACKEND=groq

# Groq API Key (Get free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Google Gemini API Key (Get free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM (if using offline local models)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ----------------------------------------------------
# 2. VOICE & SPEECH SETTINGS
# ----------------------------------------------------
# TTS_ENGINE: edge-tts (High quality neural voice) or pyttsx3 (offline standard voice)
TTS_ENGINE=edge-tts

# Popular Edge-TTS Voices:
# - en-GB-RyanNeural (British Jarvis style - Recommended!)
# - en-US-ChristopherNeural (Deep male voice)
# - hi-IN-MadhurNeural (Hindi-English Hinglish voice)
EDGE_TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Wake word for JARVIS
WAKE_WORD=jarvis

# ----------------------------------------------------
# 3. USER & LOCATION SETTINGS
# ----------------------------------------------------
USER_NAME=Sir
JARVIS_NAME=JARVIS
DEFAULT_CITY=Asansol
OPENWEATHER_API_KEY=your_openweather_api_key_optional
